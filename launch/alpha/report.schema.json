{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_receipt_produced": {"type": ["boolean", "null"]},
    "collected_at": {"format": "date", "type": "string"},
    "consent_aggregate": {"const": true},
    "deterministic_demo_attempted": {"type": "boolean"},
    "deterministic_demo_completed": {"type": "boolean"},
    "deterministic_seconds": {"minimum": 1, "type": ["integer", "null"]},
    "external_tester": {"const": true},
    "install_attempted": {"type": "boolean"},
    "install_completed": {"type": "boolean"},
    "install_method": {"enum": ["pipx", "uv-tool", "venv", "container", "other"]},
    "lightclaw_version": {"type": "string"},
    "os_family": {"enum": ["linux", "macos", "other"]},
    "python_version": {"type": "string"},
    "report_id": {"pattern": "^alpha-[0-9a-f]{12}$", "type": "string"},
    "schema_version": {"const": 1},
    "telegram_attempted": {"type": "boolean"},
    "telegram_completed": {"type": "boolean"},
    "telegram_seconds": {"minimum": 1, "type": ["integer", "null"]}
  },
  "required": [
    "schema_version",
    "report_id",
    "collected_at",
    "external_tester",
    "consent_aggregate",
    "lightclaw_version",
    "os_family",
    "python_version",
    "install_method",
    "install_attempted",
    "install_completed",
    "deterministic_demo_attempted",
    "deterministic_demo_completed",
    "deterministic_seconds",
    "telegram_attempted",
    "telegram_completed",
    "telegram_seconds",
    "artifact_receipt_produced"
  ],
  "title": "LightClaw private alpha report",
  "type": "object"
}
